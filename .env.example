# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in the values
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL password — used by docker-compose and DATABASE_URL
POSTGRES_PASSWORD=change_me_strong_password_here

# JWT signing secret — MUST be at least 32 characters.
# Generate a secure value: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# URL the browser uses to reach the frontend (used for CORS on backend)
FRONTEND_URL=http://localhost:3000

# Backend API URL for local development (without Docker)
# When using Docker, docker-compose sets this to http://backend:3001 internally
BACKEND_API_URL=http://localhost:3001
